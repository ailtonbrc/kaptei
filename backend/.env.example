# Banco e servidor
DATABASE_URL=postgres://USUARIO:SENHA@HOST:5432/kaptei?sslmode=require
# Compatibilidade transitória com instalações antigas quando DATABASE_URL estiver vazia:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=USUARIO
# DB_PASSWORD=SENHA
# DB_DATABASE=kaptei
# DB_SSLMODE=disable
PORT=8080
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
# Gere com: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
CONFIG_ENCRYPTION_KEY=SUBSTITUA_POR_32_BYTES_ALEATORIOS_EM_BASE64
APP_PUBLIC_URL=https://app.seudominio.com.br
CORS_ALLOWED_ORIGINS=https://app.seudominio.com.br
COOKIE_SECURE=true

# Limites HTTP
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=1048576
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=5m
PUBLIC_LEAD_RATE_LIMIT=10

# Métricas de conversão do site: expurgo após a validade definida no banco
METRICAS_CONVERSAO_EXPURGO_INTERVAL=24h
PUBLIC_LEAD_RATE_WINDOW=1m
PUBLIC_READ_RATE_LIMIT=180
PUBLIC_READ_RATE_WINDOW=1m
TRUST_PROXY_HEADERS=false

# Processamento assíncrono e retentativas
OUTBOX_POLL_INTERVAL=2s
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LOCK_DURATION=1m
OUTBOX_INITIAL_BACKOFF=30s
OUTBOX_MAX_BACKOFF=30m

# Fotos de imóveis: use local em desenvolvimento e s3 em produção
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/objetos
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/arquivos
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_PATH_STYLE=false
IMAGE_MAX_BYTES=15728640
IMAGE_MAX_PIXELS=24000000
IMAGE_MAIN_MAX_DIMENSION=2400
IMAGE_THUMB_MAX_DIMENSION=640
IMAGE_JPEG_QUALITY=85
IMAGE_MAX_CONCURRENT_PROCESSING=2

# Meta Lead Ads: deixe todas vazias para manter o canal desabilitado
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Grupo OLX: segredo HTTP Basic compartilhado para recebimento de leads
GRUPO_OLX_WEBHOOK_SECRET=
META_GRAPH_BASE_URL=
META_GRAPH_API_VERSION=
META_HTTP_TIMEOUT=15s

# Cobrança Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PicPay permanece desabilitado até homologação
PICPAY_TOKEN=
PICPAY_SELLER_TOKEN=
